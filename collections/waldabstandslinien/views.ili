INTERLIS 2.3;

!! Views of the waldabstandslinien collection: what its feature collection serves and
!! its map is drawn from - the geometry, the attributes, references
!! resolved to the referenced object's attributes, a multilingual text as
!! one column per language. convert-sql turns each VIEW into a SQL view.

MODEL Waldabstandslinien_Views (en)
  AT "mailto:test@example.org"
  VERSION "2026-10-07" =

  IMPORTS Waldabstandslinien_V1_2;

  VIEW TOPIC Views EXTENDS Waldabstandslinien_V1_2.Geobasisdaten =

    VIEW linien
      PROJECTION OF W ~ Waldabstandslinien_V1_2.Geobasisdaten.Waldabstand_Linie;
      =
      ATTRIBUTE
        publiziertab := W -> publiziertAb;
        publiziertbis := W -> publiziertBis;
        rechtsstatus := W -> Rechtsstatus;
        bemerkungen := W -> Bemerkungen;
        typ_code := W -> WAL -> Code;
        typ_bezeichnung := W -> WAL -> Bezeichnung;
        typ_abkuerzung := W -> WAL -> Abkuerzung;
        typ_verbindlichkeit := W -> WAL -> Verbindlichkeit;
        geometrie := W -> Geometrie;
    END linien;

  END Views;

END Waldabstandslinien_Views.

INTERLIS 2.3;

!! Map views of the waldabstandslinien collection: each VIEW projects one class with
!! the geometry its GRAPHIC draws and every attribute its WHERE clauses
!! test, references flattened. convert-sql turns each into a SQL view the
!! SLD filters run on as is.

MODEL Waldabstandslinien_Views (en)
  AT "mailto:test@example.org"
  VERSION "2026-10-06" =

  IMPORTS Waldabstandslinien_V1_2;

  VIEW TOPIC Views EXTENDS Waldabstandslinien_V1_2.Geobasisdaten =

    VIEW waldabstand_linie_map
      PROJECTION OF W ~ Waldabstandslinien_V1_2.Geobasisdaten.Waldabstand_Linie;
      =
      ATTRIBUTE
        geometrie := W -> Geometrie;
    END waldabstand_linie_map;

  END Views;

END Waldabstandslinien_Views.

INTERLIS 2.4;

!! Line color sampled from the dataset's own WMS legend (see signs.xtf).

MODEL Waldabstandslinien_Symbology (en)
  AT "mailto:test@example.org"
  VERSION "2026-10-06" =

  IMPORTS StandardSymbology;
  IMPORTS Waldabstandslinien_Views;

  SIGN BASKET Signs ~ StandardSymbology.StandardSigns
    OBJECTS OF PolylineSign: WaldGreen;

  TOPIC Graphics =
    DEPENDS ON Waldabstandslinien_Views.Views;

    GRAPHIC Waldabstand_Graphics
      BASED ON Waldabstandslinien_Views.Views.linien =

      WaldabstandRule OF StandardSymbology.StandardSigns.PolylineSign: (
          Sign := {WaldGreen};
          Geometry := geometrie;
          Priority := 100);

    END Waldabstand_Graphics;

  END Graphics;

END Waldabstandslinien_Symbology.

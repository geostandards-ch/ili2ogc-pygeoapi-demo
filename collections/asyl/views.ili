INTERLIS 2.3;

!! Map views of the asyl collection: each VIEW projects one class with
!! the geometry its GRAPHIC draws and every attribute its WHERE clauses
!! test, references flattened. convert-sql turns each into a SQL view the
!! SLD filters run on as is.

MODEL Asyl_Views (en)
  AT "mailto:test@example.org"
  VERSION "2026-10-06" =

  IMPORTS SectoralPlanForAsylum_LV95_V1_4;

  VIEW TOPIC Views EXTENDS SectoralPlanForAsylum_LV95_V1_4.SectoralPlanForAsylum_WithLatestModification =

    VIEW facility_map
      PROJECTION OF F ~ BaseModel_SectoralPlans_LV95_V1_4.SectoralPlans_WithLatestModification.Facility;
      =
      ATTRIBUTE
        kind_id := F -> FacilityKind -> Reference -> KindID;
        status_id := F -> FacilityStatus -> Reference -> StatusID;
        point := F -> Point;
    END facility_map;

  END Views;

END Asyl_Views.

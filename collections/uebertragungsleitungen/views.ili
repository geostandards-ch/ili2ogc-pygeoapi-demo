INTERLIS 2.3;

!! Map views of the uebertragungsleitungen collection: each VIEW projects one class with
!! the geometry its GRAPHIC draws and every attribute its WHERE clauses
!! test, references flattened. convert-sql turns each into a SQL view the
!! SLD filters run on as is.

MODEL Uebertragungsleitungen_Views (en)
  AT "mailto:test@example.org"
  VERSION "2026-10-06" =

  IMPORTS TransmissionLinesSectoralPlan_V1_4;

  VIEW TOPIC Views EXTENDS TransmissionLinesSectoralPlan_V1_4.TransmissionLinesSectoralPlan =

    VIEW planningmeasure_map
      PROJECTION OF M ~ BaseModel_SectoralPlans_LV95_V1_4.SectoralPlans_WithLatestModification.PlanningMeasure;
      =
      ATTRIBUTE
        type_id := M -> MeasureType -> Reference -> TypeID;
        coord_id := M -> CoordinationLevel -> Reference -> CoordID;
        surface := M -> Surface;
    END planningmeasure_map;

  END Views;

END Uebertragungsleitungen_Views.

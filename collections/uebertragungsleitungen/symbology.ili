INTERLIS 2.4;

!! Cartographic signature for the "Sachplan Uebertragungsleitungen" (SUEL,
!! Geobasisdatensatz 94.1) PlanningMeasure surfaces, lines and points,
!! after the real official SLDs (suel_sp_uebertragungsleitungen_
!! planningmeasure_{surface,line,point}.sld): border-only dashed surfaces,
!! a blue line, a yellow circle. What those SLDs draw with WESP font glyphs
!! is reproduced as far as a native mark allows - see signs.xtf.
!! The geometries are MultiSurface/MultiLine/MultiPoint STRUCTUREs, reached
!! with the association-path operator (surface -> Surfaces -> Surface;
!! INTERLIS refman: ObjectOrAttributePath = PathEl {'->' PathEl}, valid
!! "von der aktuellen Struktur aus"). The MeasureType/CoordinationLevel
!! catalogue keys the WHERE clauses test are flattened by the VIEWs
!! (type_id, coord_id).

MODEL Uebertragungsleitungen_Symbology (en)
  AT "mailto:test@example.org"
  VERSION "2026-10-06" =

  IMPORTS StandardSymbology;
  IMPORTS Uebertragungsleitungen_Views;

  SIGN BASKET Signs ~ StandardSymbology.StandardSigns
    OBJECTS OF SurfaceSign: CorridorFestsetzung, KorridorZwischenergebnis, GebietFestsetzung;
    OBJECTS OF PolylineSign: LeitungAufhebung, AufhebungFestsetzung, AufhebungZwischenergebnis, AufhebungVororientierung;
    OBJECTS OF SymbolSign: EndpunktVororientierung, Pfeilspitze;

  TOPIC Graphics =
    DEPENDS ON Uebertragungsleitungen_Views.Views;

    GRAPHIC PlanningMeasure_Graphics
      BASED ON Uebertragungsleitungen_Views.Views.planningmeasure_flaechen =

      CorridorFestsetzungRule OF StandardSymbology.StandardSigns.SurfaceSign:
        WHERE (type_id == "mt2") AND (coord_id == 1) (
          Sign := {CorridorFestsetzung};
          Geometry := surface -> Surfaces -> Surface;
          Priority := 1);

      KorridorZwischenergebnisRule OF StandardSymbology.StandardSigns.SurfaceSign:
        WHERE (type_id == "mt2") AND (coord_id == 2) (
          Sign := {KorridorZwischenergebnis};
          Geometry := surface -> Surfaces -> Surface;
          Priority := 2);

      GebietFestsetzungRule OF StandardSymbology.StandardSigns.SurfaceSign:
        WHERE (type_id == "mt3") AND (coord_id == 1) (
          Sign := {GebietFestsetzung};
          Geometry := surface -> Surfaces -> Surface;
          Priority := 3);

    END PlanningMeasure_Graphics;

    GRAPHIC PlanningMeasure_Linien_Graphics
      BASED ON Uebertragungsleitungen_Views.Views.planningmeasure_linien =

      LeitungAufhebungRule OF StandardSymbology.StandardSigns.PolylineSign:
        WHERE type_id == "mt4" (
          Sign := {LeitungAufhebung};
          Geometry := line -> Lines -> Line;
          Priority := 1);

      AufhebungFestsetzungRule OF StandardSymbology.StandardSigns.PolylineSign:
        WHERE (type_id == "mt4") AND (coord_id == 1) (
          Sign := {AufhebungFestsetzung};
          Geometry := line -> Lines -> Line;
          Priority := 2);

      AufhebungZwischenergebnisRule OF StandardSymbology.StandardSigns.PolylineSign:
        WHERE (type_id == "mt4") AND (coord_id == 2) (
          Sign := {AufhebungZwischenergebnis};
          Geometry := line -> Lines -> Line;
          Priority := 2);

      AufhebungVororientierungRule OF StandardSymbology.StandardSigns.PolylineSign:
        WHERE (type_id == "mt4") AND (coord_id == 3) (
          Sign := {AufhebungVororientierung};
          Geometry := line -> Lines -> Line;
          Priority := 2);

    END PlanningMeasure_Linien_Graphics;

    GRAPHIC PlanningMeasure_Punkte_Graphics
      BASED ON Uebertragungsleitungen_Views.Views.planningmeasure_punkte =

      EndpunktVororientierungRule OF StandardSymbology.StandardSigns.SymbolSign:
        WHERE (type_id == "mt1") AND (coord_id == 3) (
          Sign := {EndpunktVororientierung};
          Geometry := point -> Points -> Point;
          Priority := 1);

      PfeilspitzeRule OF StandardSymbology.StandardSigns.SymbolSign:
        WHERE (type_id == "mt1") AND (coord_id == 3) (
          Sign := {Pfeilspitze};
          Geometry := point -> Points -> Point;
          Priority := 2);

    END PlanningMeasure_Punkte_Graphics;

  END Graphics;

END Uebertragungsleitungen_Symbology.

<?xml version="1.0" encoding="UTF-8"?>

<!-- Sign data for symbology.ili. Colors sourced from the real
     official WMS legend each dataset is actually rendered with - the exact
     source of each color is noted next to it. Not a geocat.ch-published SLD/QML
     (none was found for any of these datasets): reverse-engineered by
     sampling the legend swatch pixels of each dataset's own live WMS. -->

<ili:transfer xmlns:ili="http://www.interlis.ch/xtf/2.4/INTERLIS"
  xmlns="http://www.interlis.ch/xtf/2.4/StandardSymbology"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ili:headersection>
    <ili:models>
      <ili:model>Richtplanung_Symbology</ili:model>
    </ili:models>
    <ili:sender>ili2ogc-pygeoapi-demo</ili:sender>
    <ili:comment>Surface and point signs for richtplanung, sourced from geodienste.ch's real WMS styles and legend</ili:comment>
  </ili:headersection>

  <ili:datasection>
    <StandardSigns ili:bid="Signs00000001">
      <!-- geodienste.ch harmonized WMS (wfs.geodienste.ch/
           richtplanung_erneuerbare_energien_v1_0_0), layer
           windenergie_flaechen, real SLD from WMS GetStyles:
           "Richtplaninhalt" fill #a900e6, "Ausgangslage" fill #ffffff
           with a #e89eff stroke of width 1. -->
      <Color ili:tid="4">
        <Name>rp_windenergie_richtplaninhalt_purple</Name>
        <L>44.446</L>
        <C>110.1224</C>
        <H>318.363</H>
        <T>1.0</T>
      </Color>

      <Color ili:tid="5">
        <Name>rp_windenergie_ausgangslage_white</Name>
        <L>100.0</L>
        <C>0.0</C>
        <H>0.0</H>
        <T>1.0</T>
      </Color>

      <Color ili:tid="6">
        <Name>rp_windenergie_ausgangslage_border</Name>
        <L>75.3462</L>
        <C>57.3219</C>
        <H>319.3479</H>
        <T>1.0</T>
      </Color>

      <!-- Same service, layer wasserkraft_punkte: its GetStyles export
           lost the point symbol (empty PointSymbolizer), so taken from
           GetLegendGraphic: "Richtplaninhalt" a filled #005ce6 square,
           "Ausgangslage" a #a0e9ff square outline, about 16 px. -->
      <Color ili:tid="7">
        <Name>rp_wasserkraft_richtplaninhalt_blue</Name>
        <L>43.3081</L>
        <C>82.0424</C>
        <H>292.9951</H>
        <T>1.0</T>
      </Color>

      <Color ili:tid="8">
        <Name>rp_wasserkraft_ausgangslage_cyan</Name>
        <L>88.4322</L>
        <C>24.7924</C>
        <H>225.8954</H>
        <T>1.0</T>
      </Color>

      <Font ili:tid="20">
        <Name>DemoMarks</Name>
        <Internal>true</Internal>
        <Type>symbol</Type>
      </Font>

      <FontSymbol ili:tid="30">
        <Name>Square_Filled</Name>
        <Font ili:ref="20"></Font>
        <Geometry>
          <FontSymbol_Surface>
            <FillColor ili:ref="7"></FillColor>
            <Geometry>
              <SURFACE>
                <BOUNDARY>
                  <POLYLINE>
                  <COORD><C1>-0.5</C1><C2>-0.5</C2></COORD>
                  <COORD><C1>0.5</C1><C2>-0.5</C2></COORD>
                  <COORD><C1>0.5</C1><C2>0.5</C2></COORD>
                  <COORD><C1>-0.5</C1><C2>0.5</C2></COORD>
                  <COORD><C1>-0.5</C1><C2>-0.5</C2></COORD>
                  </POLYLINE>
                </BOUNDARY>
              </SURFACE>
            </Geometry>
          </FontSymbol_Surface>
        </Geometry>
      </FontSymbol>

      <FontSymbol ili:tid="31">
        <Name>Square_Outline</Name>
        <Font ili:ref="20"></Font>
        <Geometry>
          <FontSymbol_Polyline>
            <Color ili:ref="8"></Color>
            <Geometry>
              <POLYLINE>
              <COORD><C1>-0.5</C1><C2>-0.5</C2></COORD>
              <COORD><C1>0.5</C1><C2>-0.5</C2></COORD>
              <COORD><C1>0.5</C1><C2>0.5</C2></COORD>
              <COORD><C1>-0.5</C1><C2>0.5</C2></COORD>
              <COORD><C1>-0.5</C1><C2>-0.5</C2></COORD>
              </POLYLINE>
            </Geometry>
          </FontSymbol_Polyline>
        </Geometry>
      </FontSymbol>

      <LineStyle_Solid ili:tid="44">
        <Name>RichtplanAusgangslageBorder_Solid</Name>
        <Color ili:ref="6"></Color>
      </LineStyle_Solid>

      <PolylineSign ili:tid="104">
        <ili:Name>RichtplanAusgangslageBorder</ili:Name>
        <Style ili:ref="44">
          <PolylineSignLineStyleAssoc>
            <Offset>0.0</Offset>
          </PolylineSignLineStyleAssoc>
        </Style>
      </PolylineSign>

      <SurfaceSign ili:tid="110">
        <ili:Name>RichtplaninhaltPurple</ili:Name>
        <FillColor ili:ref="4"></FillColor>
      </SurfaceSign>

      <SurfaceSign ili:tid="111">
        <ili:Name>AusgangslageWhite</ili:Name>
        <FillColor ili:ref="5"></FillColor>
        <Border ili:ref="104"></Border>
      </SurfaceSign>

      <SymbolSign ili:tid="120">
        <ili:Name>WasserkraftRichtplaninhaltBlue</ili:Name>
        <Color ili:ref="7"></Color>
        <Symbol ili:ref="30"></Symbol>
        <Scale>16</Scale>
      </SymbolSign>

      <SymbolSign ili:tid="121">
        <ili:Name>WasserkraftAusgangslageCyan</ili:Name>
        <Color ili:ref="8"></Color>
        <Symbol ili:ref="31"></Symbol>
        <Scale>16</Scale>
      </SymbolSign>

    </StandardSigns>
  </ili:datasection>
</ili:transfer>

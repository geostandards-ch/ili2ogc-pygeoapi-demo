INTERLIS 2.3;

!! Views of the mainroads collection: what its feature collection serves and
!! its map is drawn from - the geometry, the attributes, references
!! resolved to the referenced object's attributes, a multilingual text as
!! one column per language. convert-sql turns each VIEW into a SQL view.

MODEL MainRoads_Views (en)
  AT "mailto:test@example.org"
  VERSION "2026-10-07" =

  IMPORTS MainRoads_LV95_V1_1;

  VIEW TOPIC Views EXTENDS MainRoads_LV95_V1_1.MainRoads =

    VIEW roadsegments
      PROJECTION OF R ~ MainRoads_LV95_V1_1.MainRoads.RoadSegment;
      =
      ATTRIBUTE
        canton := R -> Canton;
        roadnumber := R -> RoadNumber;
        segmentdescription := R -> SegmentDescription;
        geometry := R -> Geometry;
    END roadsegments;

  END Views;

END MainRoads_Views.

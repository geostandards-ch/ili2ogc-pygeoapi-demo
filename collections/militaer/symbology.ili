INTERLIS 2.4;

!! Cartographic signature for the "Sachplan Militaer" (Geobasisdatensatz
!! 32) PlanningMeasure surface theme, reproducing the real official SLD
!! (spm_sp_militaer_planningmeasure_kraft.sld): one rule per measure type
!! (MeasureType catalogue, TypeID 32-M-*) and coordination level (shared
!! CoordinationLevel catalogue, CoordID 1..3). The point-modelled 32-M-1
!! measures (Standortfestlegung) have their own GRAPHIC: a filled circle per
!! coordination level, after the SPM documentation (signs.xtf). The
!! facilities, drawn with glyphs of the WESP TrueType font (not
!! redistributable), are not reproduced.

MODEL Militaer_Symbology (en)
  AT "mailto:test@example.org"
  VERSION "2026-10-06" =

  IMPORTS StandardSymbology;
  IMPORTS Militaer_Views;

  SIGN BASKET Signs ~ StandardSymbology.StandardSigns
    OBJECTS OF SurfaceSign: AnlageperimeterFestsetzung, AnlageperimeterZwischenergebnis, AnlageperimeterVororientierung, HindernisbegrenzungFestsetzung, HindernisbegrenzungZwischenergebnis, LaermbelastungFestsetzung, KonsultationsbereichFestsetzung, Laerm60Festsetzung, Laerm60Zwischenergebnis, Laerm60Vororientierung, Laerm55Festsetzung, Laerm55Zwischenergebnis, Laerm55Vororientierung;
    OBJECTS OF SymbolSign: StandortfestlegungFestsetzung, StandortfestlegungZwischenergebnis, StandortfestlegungVororientierung;

  TOPIC Graphics =
    DEPENDS ON Militaer_Views.Views;

    GRAPHIC PlanningMeasure_Graphics
      BASED ON Militaer_Views.Views.planningmeasure_flaechen =

      AnlageperimeterFestsetzungRule OF StandardSymbology.StandardSigns.SurfaceSign:
        WHERE (type_id == "32-M-2") AND (coord_id == 1) (
          Sign := {AnlageperimeterFestsetzung};
          Geometry := surface -> Surfaces -> Surface;
          Priority := 2);

      AnlageperimeterZwischenergebnisRule OF StandardSymbology.StandardSigns.SurfaceSign:
        WHERE (type_id == "32-M-2") AND (coord_id == 2) (
          Sign := {AnlageperimeterZwischenergebnis};
          Geometry := surface -> Surfaces -> Surface;
          Priority := 3);

      AnlageperimeterVororientierungRule OF StandardSymbology.StandardSigns.SurfaceSign:
        WHERE (type_id == "32-M-2") AND (coord_id == 3) (
          Sign := {AnlageperimeterVororientierung};
          Geometry := surface -> Surfaces -> Surface;
          Priority := 4);

      HindernisbegrenzungFestsetzungRule OF StandardSymbology.StandardSigns.SurfaceSign:
        WHERE (type_id == "32-M-3") AND (coord_id == 1) (
          Sign := {HindernisbegrenzungFestsetzung};
          Geometry := surface -> Surfaces -> Surface;
          Priority := 5);

      HindernisbegrenzungZwischenergebnisRule OF StandardSymbology.StandardSigns.SurfaceSign:
        WHERE (type_id == "32-M-3") AND (coord_id == 2) (
          Sign := {HindernisbegrenzungZwischenergebnis};
          Geometry := surface -> Surfaces -> Surface;
          Priority := 6);

      LaermbelastungFestsetzungRule OF StandardSymbology.StandardSigns.SurfaceSign:
        WHERE (type_id == "32-M-4") AND (coord_id == 1) (
          Sign := {LaermbelastungFestsetzung};
          Geometry := surface -> Surfaces -> Surface;
          Priority := 7);

      KonsultationsbereichFestsetzungRule OF StandardSymbology.StandardSigns.SurfaceSign:
        WHERE (type_id == "32-M-5") AND (coord_id == 1) (
          Sign := {KonsultationsbereichFestsetzung};
          Geometry := surface -> Surfaces -> Surface;
          Priority := 8);

      Laerm60FestsetzungRule OF StandardSymbology.StandardSigns.SurfaceSign:
        WHERE (type_id == "32-M-41") AND (coord_id == 1) (
          Sign := {Laerm60Festsetzung};
          Geometry := surface -> Surfaces -> Surface;
          Priority := 9);

      Laerm60ZwischenergebnisRule OF StandardSymbology.StandardSigns.SurfaceSign:
        WHERE (type_id == "32-M-41") AND (coord_id == 2) (
          Sign := {Laerm60Zwischenergebnis};
          Geometry := surface -> Surfaces -> Surface;
          Priority := 10);

      Laerm60VororientierungRule OF StandardSymbology.StandardSigns.SurfaceSign:
        WHERE (type_id == "32-M-41") AND (coord_id == 3) (
          Sign := {Laerm60Vororientierung};
          Geometry := surface -> Surfaces -> Surface;
          Priority := 11);

      Laerm55FestsetzungRule OF StandardSymbology.StandardSigns.SurfaceSign:
        WHERE (type_id == "32-M-42") AND (coord_id == 1) (
          Sign := {Laerm55Festsetzung};
          Geometry := surface -> Surfaces -> Surface;
          Priority := 12);

      Laerm55ZwischenergebnisRule OF StandardSymbology.StandardSigns.SurfaceSign:
        WHERE (type_id == "32-M-42") AND (coord_id == 2) (
          Sign := {Laerm55Zwischenergebnis};
          Geometry := surface -> Surfaces -> Surface;
          Priority := 13);

      Laerm55VororientierungRule OF StandardSymbology.StandardSigns.SurfaceSign:
        WHERE (type_id == "32-M-42") AND (coord_id == 3) (
          Sign := {Laerm55Vororientierung};
          Geometry := surface -> Surfaces -> Surface;
          Priority := 14);

    END PlanningMeasure_Graphics;

    GRAPHIC PlanningMeasure_Punkte_Graphics
      BASED ON Militaer_Views.Views.planningmeasure_punkte =

      StandortfestlegungFestsetzungRule OF StandardSymbology.StandardSigns.SymbolSign:
        WHERE (type_id == "32-M-1") AND (coord_id == 1) (
          Sign := {StandortfestlegungFestsetzung};
          Geometry := point -> Points -> Point;
          Priority := 1);

      StandortfestlegungZwischenergebnisRule OF StandardSymbology.StandardSigns.SymbolSign:
        WHERE (type_id == "32-M-1") AND (coord_id == 2) (
          Sign := {StandortfestlegungZwischenergebnis};
          Geometry := point -> Points -> Point;
          Priority := 2);

      StandortfestlegungVororientierungRule OF StandardSymbology.StandardSigns.SymbolSign:
        WHERE (type_id == "32-M-1") AND (coord_id == 3) (
          Sign := {StandortfestlegungVororientierung};
          Geometry := point -> Points -> Point;
          Priority := 3);

    END PlanningMeasure_Punkte_Graphics;

  END Graphics;

END Militaer_Symbology.

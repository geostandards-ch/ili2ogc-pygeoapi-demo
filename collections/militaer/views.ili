INTERLIS 2.3;

!! Views of the militaer collection: one VIEW per geometry, since a
!! PlanningMeasure carries a Point, a Line or a Surface and a feature
!! service serves one geometry per collection. Each keeps only the
!! measures that have its geometry, with the catalogue keys and their
!! names resolved. planningmeasure_flaechen also feeds the map: its
!! GRAPHIC tests type_id and coord_id.
!! No Facility name: every militaer measure references a Facility_SPM,
!! whose reference column a VIEW path does not follow; the measure's own
!! Name is the facility's.

MODEL Militaer_Views (en)
  AT "mailto:test@example.org"
  VERSION "2026-10-06" =

  IMPORTS SectoralPlanForMilitaryInfrastructure_LV95_V1_4;

  VIEW TOPIC Views EXTENDS SectoralPlanForMilitaryInfrastructure_LV95_V1_4.SectoralPlanForMilitaryInfrastructure_WithLatestModification =

    VIEW planningmeasure_flaechen
      PROJECTION OF M ~ BaseModel_SectoralPlans_LV95_V1_4.SectoralPlans_WithLatestModification.PlanningMeasure;
      WHERE DEFINED (M -> Surface);
      =
      ATTRIBUTE
        name := M -> Name;
        description := M -> Description;
        type_id := M -> MeasureType -> Reference -> TypeID;
        type_name := M -> MeasureType -> Reference -> Name;
        coord_id := M -> CoordinationLevel -> Reference -> CoordID;
        coord_name := M -> CoordinationLevel -> Reference -> Name;
        status_id := M -> PlanningStatus -> Reference -> StatusID;
        status_name := M -> PlanningStatus -> Reference -> Name;
        symbolori := M -> SymbolOri;
        modinfo_validfrom := M -> ModInfo -> ValidFrom;
        modinfo_validuntil := M -> ModInfo -> ValidUntil;
        modinfo_latestmodification := M -> ModInfo -> LatestModification;
        facility_name := M -> Facility -> Name;
        surface := M -> Surface;
    END planningmeasure_flaechen;

    VIEW planningmeasure_punkte
      PROJECTION OF M ~ BaseModel_SectoralPlans_LV95_V1_4.SectoralPlans_WithLatestModification.PlanningMeasure;
      WHERE DEFINED (M -> Point);
      =
      ATTRIBUTE
        name := M -> Name;
        description := M -> Description;
        type_id := M -> MeasureType -> Reference -> TypeID;
        type_name := M -> MeasureType -> Reference -> Name;
        coord_id := M -> CoordinationLevel -> Reference -> CoordID;
        coord_name := M -> CoordinationLevel -> Reference -> Name;
        status_id := M -> PlanningStatus -> Reference -> StatusID;
        status_name := M -> PlanningStatus -> Reference -> Name;
        symbolori := M -> SymbolOri;
        modinfo_validfrom := M -> ModInfo -> ValidFrom;
        modinfo_validuntil := M -> ModInfo -> ValidUntil;
        modinfo_latestmodification := M -> ModInfo -> LatestModification;
        facility_name := M -> Facility -> Name;
        point := M -> Point;
    END planningmeasure_punkte;

  END Views;

END Militaer_Views.

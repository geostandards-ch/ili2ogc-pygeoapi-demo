INTERLIS 2.3;

!! Views of the buildinglines collection: what its feature collection serves and
!! its map is drawn from - the geometry, the attributes, references
!! resolved to the referenced object's attributes, a multilingual text as
!! one column per language. convert-sql turns each VIEW into a SQL view.

MODEL BuildingLines_Views (en)
  AT "mailto:test@example.org"
  VERSION "2026-10-07" =

  IMPORTS BuildingLinesForMotorways_V2_2;

  VIEW TOPIC Views EXTENDS BuildingLinesForMotorways_V2_2.BuildingLines =

    VIEW buildinglines
      PROJECTION OF B ~ BuildingLinesForMotorways_V2_2.BuildingLines.BuildingLine;
      =
      ATTRIBUTE
        status := B -> Status;
        approvaldate := B -> ApprovalDate;
        approvingauthority := B -> ApprovingAuthority;
        planningapprovalname := B -> PlanningApprovalName;
        publicationdatefrom := B -> PublicationDateFrom;
        publicationdateto := B -> PublicationDateTo;
        weblink := B -> WebLink;
        geometry := B -> Geometry;
    END buildinglines;

  END Views;

END BuildingLines_Views.

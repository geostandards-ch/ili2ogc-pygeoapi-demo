<?xml version="1.0" encoding="UTF-8"?>

<!-- Sign data for symbology.ili. Colors sourced from the real
     official WMS legend each dataset is actually rendered with - the exact
     source of each color is noted next to it. Not a geocat.ch-published SLD/QML
     (none was found for any of these datasets): reverse-engineered by
     sampling the legend swatch pixels of each dataset's own live WMS. -->

<ili:transfer xmlns:ili="http://www.interlis.ch/xtf/2.4/INTERLIS"
  xmlns="http://www.interlis.ch/xtf/2.4/StandardSymbology"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ili:headersection>
    <ili:models>
      <ili:model>BuildingLines_Symbology</ili:model>
    </ili:models>
    <ili:sender>ili2ogc-pygeoapi-demo</ili:sender>
    <ili:comment>Line color for buildinglines, sourced from the dataset's own real WMS legend</ili:comment>
  </ili:headersection>

  <ili:datasection>
    <StandardSigns ili:bid="Signs00000001">
      <!-- geo.admin.ch WMS (wms.geo.admin.ch), layer
           ch.astra.baulinien-nationalstrassen, legend image, "In force"
           swatch: #00E600 (all 30 real BuildingLine rows in this demo
           have status=inForce). -->
      <Color ili:tid="3">
        <Name>astra_baulinien_inforce_green</Name>
        <L>79.9</L>
        <C>110.8</C>
        <H>136.02</H>
        <T>1.0</T>
      </Color>

      <LineStyle_Solid ili:tid="43">
        <Name>BuildingLinesGreen_Solid</Name>
        <Color ili:ref="3"></Color>
      </LineStyle_Solid>

      <PolylineSign ili:tid="103">
        <ili:Name>BuildingLinesGreen</ili:Name>
        <Style ili:ref="43">
          <PolylineSignLineStyleAssoc>
            <Offset>0.0</Offset>
          </PolylineSignLineStyleAssoc>
        </Style>
      </PolylineSign>

    </StandardSigns>
  </ili:datasection>
</ili:transfer>

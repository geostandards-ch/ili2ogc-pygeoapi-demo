INTERLIS 2.4;

SYMBOLOGY MODEL StandardSymbologyScale (en)
  AT "https://example.org/models/" VERSION "2026-10-13" =

  !! Proposed extension of StandardSymbology: scale-dependent visibility for every sign
  !! interface. A drawing rule assigns the parameters like Priority. 0 = no bound; a sign
  !! is visible where MinScaleDenominator <= scale denominator < MaxScaleDenominator.

  IMPORTS StandardSymbology;

  DOMAIN
    SS_ScaleDenominator = 0 .. 1000000000;

  TOPIC ScaledSigns EXTENDS StandardSymbology.StandardSigns =

    CLASS TextSign (EXTENDED) =
    PARAMETER
      MinScaleDenominator : SS_ScaleDenominator;
      MaxScaleDenominator : SS_ScaleDenominator;
    END TextSign;

    CLASS SymbolSign (EXTENDED) =
    PARAMETER
      MinScaleDenominator : SS_ScaleDenominator;
      MaxScaleDenominator : SS_ScaleDenominator;
    END SymbolSign;

    CLASS PolylineSign (EXTENDED) =
    PARAMETER
      MinScaleDenominator : SS_ScaleDenominator;
      MaxScaleDenominator : SS_ScaleDenominator;
    END PolylineSign;

    CLASS SurfaceSign (EXTENDED) =
    PARAMETER
      MinScaleDenominator : SS_ScaleDenominator;
      MaxScaleDenominator : SS_ScaleDenominator;
    END SurfaceSign;

  END ScaledSigns;

END StandardSymbologyScale.

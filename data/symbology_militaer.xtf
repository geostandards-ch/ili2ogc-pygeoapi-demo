<?xml version="1.0" encoding="UTF-8"?>

<!-- Sign data for models/SachplanMilitaer.ili, from the real official SLD
     ("exemples supplémentaires démo pygeoapi/SLD Sachpläne/SP Militär/
     spm_sp_militaer_planningmeasure_kraft.sld"): fills, border colours,
     widths and the 9/4 dash of each MeasureType/CoordinationLevel rule.
     The Konsultationsbereich rule of the official SLD is a 45-degree
     `horline` hatch; it is drawn here as its red outline only: MapServer
     (this demo's map renderer) has no SLD hatch - it knows only the
     square/circle/triangle/star/cross/x marks and rejects inline images -
     although convert-sld writes a valid SE hatch from a SurfaceSign
     HatchSymb. Colours are the LCh equivalents of the SLD's hex. -->


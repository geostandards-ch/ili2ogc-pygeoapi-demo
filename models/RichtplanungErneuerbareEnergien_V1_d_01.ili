INTERLIS 2.3;
MODEL RichtplanungErneuerbareEnergien_V1_d_01 (en)
  AT "mailto:test@example.org"
  VERSION "2024-01-01" =
  IMPORTS RichtplanungErneuerbareEnergien_V1;
  VIEW TOPIC Objekte_d EXTENDS RichtplanungErneuerbareEnergien_V1.Objekte =
    VIEW view_flaeche
      PROJECTION OF RichtplanungErneuerbareEnergien_V1.Objekte.Flaeche;
      =
      ATTRIBUTE
        energieform := Flaeche -> Energieform;
        objektbezeichnung := Flaeche -> Objektbezeichnung;
        objektart := Flaeche -> Objektart;
        genehmigungsdatum := Flaeche -> Genehmigungsdatum;
        beschlussdatum_kanton := Flaeche -> BeschlussdatumKanton;
        weblink := Flaeche -> Weblink;
        bemerkungen := Flaeche -> Bemerkungen;
        kanton := Flaeche -> Kanton;
    END view_flaeche;
  END Objekte_d;
END RichtplanungErneuerbareEnergien_V1_d_01.

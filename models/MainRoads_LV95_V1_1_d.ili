INTERLIS 2.3;
MODEL MainRoads_LV95_V1_1_d (en)
  AT "mailto:maxime.collombin@netplus.ch"
  VERSION "2026-08-28" =
  IMPORTS MainRoads_LV95_V1_1;
  VIEW TOPIC MainRoads_d EXTENDS MainRoads_LV95_V1_1.MainRoads =
    VIEW view_roadsegment
      PROJECTION OF MainRoads_LV95_V1_1.MainRoads.RoadSegment;
      =
      ATTRIBUTE
        roadnumber := RoadSegment -> RoadNumber;
        segmentdescription := RoadSegment -> SegmentDescription;
        canton := RoadSegment -> Canton;
    END view_roadsegment;
  END MainRoads_d;
END MainRoads_LV95_V1_1_d.

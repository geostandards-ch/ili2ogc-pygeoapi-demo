INTERLIS 2.4;

!! Cartographic signatures for this demo's 3 line-geometry collections
!! (waldabstand_geo, mainroads, buildinglines) - each GRAPHIC's Geometry
!! path reaches a direct POLYLINE-typed attribute on the real base class
!! (Waldabstand_Linie.Geometrie, RoadSegment.Geometry, BuildingLine.Geometry)
!! - and for flaeche_geo, whose Flaeche.Geometrie is a MultiSurface
!! STRUCTURE (a BAG of Surface) reached with Geometrie -> Surfaces -> Surface.
!!
!! Colors come from each dataset's real WMS (see data/symbology.xtf).
!! Flaeche_Graphics reproduces geodienste.ch's windenergie_flaechen SLD.
!! Its "Richtplaninhalt" rule carries no filter in that export; it is
!! rebuilt here as the 4 Richtplaninhalt sub-values. Its "Ausgangslage"
!! rule also tests the Energieform catalogue text (the BFE catalogue is
!! merged into the transfer). Its 2 "Ausschlussgebiet" rules are not
!! reproduced: no Ausschlussgebiet object in the SH data.
!! Punkt_Graphics follows the wasserkraft_punkte layer's legend (all SH
!! points are Wasserkraft): a filled blue square for Richtplaninhalt, a
!! cyan outline for Ausgangslage. Punkt.Geometrie is a MultiPoint STRUCTURE.

MODEL DemoSymbology (en)
  AT "mailto:test@example.org"
  VERSION "2026-09-13" =

  IMPORTS StandardSymbology;
  IMPORTS Waldabstandslinien_V1_2;
  IMPORTS MainRoads_LV95_V1_1;
  IMPORTS BuildingLinesForMotorways_V2_2;
  IMPORTS RichtplanungErneuerbareEnergien_V1;

  SIGN BASKET Signs ~ StandardSymbology.StandardSigns
    OBJECTS OF PolylineSign: WaldGreen, RoadsBrown, BuildingLinesGreen;
    OBJECTS OF SurfaceSign: RichtplaninhaltPurple, AusgangslageWhite;
    OBJECTS OF SymbolSign: WasserkraftRichtplaninhaltBlue, WasserkraftAusgangslageCyan;

  TOPIC Graphics =
    DEPENDS ON Waldabstandslinien_V1_2.Geobasisdaten, MainRoads_LV95_V1_1.MainRoads,
      BuildingLinesForMotorways_V2_2.BuildingLines, RichtplanungErneuerbareEnergien_V1.Objekte;

    GRAPHIC Waldabstand_Graphics
      BASED ON Waldabstandslinien_V1_2.Geobasisdaten.Waldabstand_Linie =

      WaldabstandRule OF StandardSymbology.StandardSigns.PolylineSign: (
          Sign := {WaldGreen};
          Geometry := Geometrie;
          Priority := 100);

    END Waldabstand_Graphics;

    GRAPHIC Roads_Graphics
      BASED ON MainRoads_LV95_V1_1.MainRoads.RoadSegment =

      RoadsRule OF StandardSymbology.StandardSigns.PolylineSign: (
          Sign := {RoadsBrown};
          Geometry := Geometry;
          Priority := 100);

    END Roads_Graphics;

    GRAPHIC BuildingLines_Graphics
      BASED ON BuildingLinesForMotorways_V2_2.BuildingLines.BuildingLine =

      BuildingLinesRule OF StandardSymbology.StandardSigns.PolylineSign: (
          Sign := {BuildingLinesGreen};
          Geometry := Geometry;
          Priority := 100);

    END BuildingLines_Graphics;

    GRAPHIC Flaeche_Graphics
      BASED ON RichtplanungErneuerbareEnergien_V1.Objekte.Flaeche =

      RichtplaninhaltRule OF StandardSymbology.StandardSigns.SurfaceSign:
        WHERE (Objektart == #Richtplaninhalt.Vororientierung) OR (Objektart == #Richtplaninhalt.Zwischenergebnis)
          OR (Objektart == #Richtplaninhalt.Festsetzung) OR (Objektart == #Richtplaninhalt.Unbekannt) (
          Sign := {RichtplaninhaltPurple};
          Geometry := Geometrie -> Surfaces -> Surface;
          Priority := 100);

      AusgangslageRule OF StandardSymbology.StandardSigns.SurfaceSign:
        WHERE (Objektart == #Ausgangslage) AND (Energieform -> Reference -> Energieform == "Windenergie") (
          Sign := {AusgangslageWhite};
          Geometry := Geometrie -> Surfaces -> Surface;
          Priority := 101);

    END Flaeche_Graphics;

    GRAPHIC Punkt_Graphics
      BASED ON RichtplanungErneuerbareEnergien_V1.Objekte.Punkt =

      WasserkraftRichtplaninhaltRule OF StandardSymbology.StandardSigns.SymbolSign:
        WHERE ((Objektart == #Richtplaninhalt.Vororientierung) OR (Objektart == #Richtplaninhalt.Zwischenergebnis)
          OR (Objektart == #Richtplaninhalt.Festsetzung) OR (Objektart == #Richtplaninhalt.Unbekannt))
          AND (Energieform -> Reference -> Energieform == "Wasserkraft") (
          Sign := {WasserkraftRichtplaninhaltBlue};
          Geometry := Geometrie -> Points -> Point;
          Priority := 100);

      WasserkraftAusgangslageRule OF StandardSymbology.StandardSigns.SymbolSign:
        WHERE (Objektart == #Ausgangslage) AND (Energieform -> Reference -> Energieform == "Wasserkraft") (
          Sign := {WasserkraftAusgangslageCyan};
          Geometry := Geometrie -> Points -> Point;
          Priority := 101);

    END Punkt_Graphics;

  END Graphics;

END DemoSymbology.
